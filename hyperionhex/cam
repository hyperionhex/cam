/*═══════════════════════════════════════════════════════════════════════╗
║  6. SD card — mount, paths, queue markers, recycling                   ║
╚═══════════════════════════════════════════════════════════════════════*/

static void photoPath(char* b, size_t n, uint32_t num) {
  snprintf(b, n, "/DCIM/IMG_%05lu.JPG", (unsigned long)num);
}
static void queuePath(char* b, size_t n, uint32_t num) {
  snprintf(b, n, "/QUEUE/%05lu", (unsigned long)num);
}

static void IRAM_ATTR btnISR();
static bool s_btnArmed = false;

// GPIO 13 is SD DAT3 — unused in 1-bit mode, but a (re)mount reconfigures it
// and would quietly disarm the shutter. Take the pin back after every mount.
static void restoreButtonPin() {
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  if (s_btnArmed) attachInterrupt(digitalPinToInterrupt(BUTTON_PIN), btnISR, FALLING);
}

// GPIO 4 doubles as SD DAT1. In 1-bit mode it is unused, but the driver
// leaves a pull-up on it that makes the flash LED glow. Reclaim it for PWM.
static void reclaimFlashPin() {
  static bool attached = false;
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  if (attached) ledcDetach(FLASH_PIN);   // remounts re-apply the pull-up
#endif
  gpio_reset_pin((gpio_num_t)FLASH_PIN);
  gpio_set_pull_mode((gpio_num_t)FLASH_PIN, GPIO_FLOATING);
  attached = true;
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(FLASH_PIN, 5000, 8);
#else
  ledcSetup(FLASH_LEDC_CH, 5000, 8);
  ledcAttachPin(FLASH_PIN, FLASH_LEDC_CH);
#endif
  FLASH_WRITE(0);
}

static bool sdMount() {
  for (int attempt = 0; attempt < 3; attempt++) {
    SD_MMC.end();
    delay(50);
    // 1-bit mode: uses only GPIO 14/15/2, leaving GPIO 4 (flash) and
    // GPIO 13 (button) free. 4-bit would be faster but takes both.
    // 20 MHz (SDMMC_FREQ_DEFAULT) rather than the 40 MHz the core defaults to
    // — kinder to the ESP32-CAM's traces. maxOpenFiles 3, not 5: each slot is
    // a FATFS sector buffer in the internal DRAM we are short of.
    if (SD_MMC.begin("/sdcard", true, false, SDMMC_FREQ_DEFAULT, 3)) {
      uint8_t t = SD_MMC.cardType();
      if (t != CARD_NONE) {
        SD_MMC.mkdir("/DCIM");
        SD_MMC.mkdir("/QUEUE");
        Serial.printf("[SD]  mounted, %llu MB, type %d\n",
                      SD_MMC.cardSize() / (1024ULL * 1024ULL), t);
        reclaimFlashPin();
        restoreButtonPin();
        return true;
      }
    }
    Serial.printf("[SD]  mount attempt %d failed\n", attempt + 1);
    delay(300);
  }
  reclaimFlashPin();
  restoreButtonPin();
  return false;
}

// One directory walk serves all three questions the queue is ever asked:
// how many, which is oldest, and give me the next few.
static uint32_t queueScan(uint32_t* firstOut, uint32_t skip,
                          uint32_t* batch, int batchMax, int* batchN) {
  if (firstOut) *firstOut = 0;
  if (batchN)   *batchN   = 0;
  if (!g_sdOK) return 0;
  if (!SD_LOCK(4000)) return g_pending;

  uint32_t count = 0, best = 0;
  File d = SD_MMC.open("/QUEUE");
  if (d) {
    File f;
    while ((f = d.openNextFile())) {
      const char* nm = f.name();
      const char* slash = strrchr(nm, '/');
      if (slash) nm = slash + 1;
      uint32_t v = strtoul(nm, nullptr, 10);
      f.close();
      if (!v) continue;
      count++;
      if (v != skip && (!best || v < best)) best = v;
      if (batch && batchN && *batchN < batchMax) batch[(*batchN)++] = v;
    }
    d.close();
  }
  SD_UNLOCK();
  if (firstOut) *firstOut = best;
  return count;
}
static inline uint32_t queueCount() { return queueScan(nullptr, 0, nullptr, 0, nullptr); }

// Oldest queued photo that the browser has not claimed for itself.
static inline uint32_t queueFirstSendable() {
  uint32_t skip = (millis() < g_claimUntil) ? g_claimNum : 0;
  uint32_t f;
  queueScan(&f, skip, nullptr, 0, nullptr);
  return f;
}

static void queueAdd(uint32_t num) {
  if (!g_sdOK) return;
  if (!SD_LOCK(4000)) return;
  char p[40]; queuePath(p, sizeof p, num);
  File f = SD_MMC.open(p, FILE_WRITE);
  if (f) f.close();
  SD_UNLOCK();
  g_pending = queueCount();
}
static void queueRemove(uint32_t num) {
  if (!g_sdOK) return;
  if (!SD_LOCK(4000)) return;
  char p[40]; queuePath(p, sizeof p, num);
  SD_MMC.remove(p);
  SD_UNLOCK();
  g_pending = queueCount();
}

// Never fail a capture because the card is full: recycle the oldest photos.
static void sdPruneIfNeeded() {
  if (!g_sdOK) return;
  uint64_t total = SD_MMC.totalBytes();
  uint64_t used  = SD_MMC.usedBytes();
  if (!total) return;
  int guard = 0;
  while ((total - used) < (uint64_t)SD_MIN_FREE_MB * 1024ULL * 1024ULL &&
         g_oldestNum + 1 < g_nextNum && guard++ < 20) {
    for (int i = 0; i < 25 && g_oldestNum + 1 < g_nextNum; i++) {
      char p[40]; photoPath(p, sizeof p, g_oldestNum);
      SD_MMC.remove(p);
      g_oldestNum++;
    }
    prefsSaveCounters();
    used = SD_MMC.usedBytes();   // re-measured per batch, it is not cheap
  }
}

static bool sdWritePhoto(uint32_t num, const uint8_t* buf, size_t len) {
  if (!g_sdOK) return false;
  if (!SD_LOCK(8000)) return false;
  bool ok = false;
  for (int attempt = 0; attempt < 2 && !ok; attempt++) {
    char p[40]; photoPath(p, sizeof p, num);
    File f = SD_MMC.open(p, FILE_WRITE);
    if (f) {
      ok = (f.write(buf, len) == len);
      f.close();
      if (!ok) SD_MMC.remove(p);
    }
    if (!ok) {                       // card hiccup → remount and try once more
      Serial.println("[SD]  write failed, remounting");
      g_sdOK = sdMount();
      if (!g_sdOK) break;
      sdPruneIfNeeded();
    }
  }
  if (ok && (num % PRUNE_EVERY) == 0) sdPruneIfNeeded();
  SD_UNLOCK();
  return ok;
}

