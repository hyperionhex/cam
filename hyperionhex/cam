║  7. Camera                                                             ║
╚═══════════════════════════════════════════════════════════════════════*/

static void applySettings() {
  sensor_t* s = esp_camera_sensor_get();
  if (!s) return;
  s->set_brightness(s,     g_cam.brightness);
  s->set_contrast(s,       g_cam.contrast);
  s->set_saturation(s,     g_cam.sat);
  s->set_sharpness(s,      g_cam.sharpness);
  s->set_wb_mode(s,        g_cam.wb_mode);
  s->set_hmirror(s,        g_cam.hmirror);
  s->set_vflip(s,          g_cam.vflip);
  s->set_quality(s,        g_cam.quality);
  s->set_special_effect(s, g_cam.effect);
  s->set_framesize(s,      FRAMESIZES[constrain(g_cam.res_idx, 0, 5)]);
}

static bool initCamera() {
  camera_config_t c = {};
  c.ledc_channel = LEDC_CHANNEL_0; c.ledc_timer = LEDC_TIMER_0;
  c.pin_d0=Y2_GPIO_NUM; c.pin_d1=Y3_GPIO_NUM; c.pin_d2=Y4_GPIO_NUM; c.pin_d3=Y5_GPIO_NUM;
  c.pin_d4=Y6_GPIO_NUM; c.pin_d5=Y7_GPIO_NUM; c.pin_d6=Y8_GPIO_NUM; c.pin_d7=Y9_GPIO_NUM;
  c.pin_xclk=XCLK_GPIO_NUM; c.pin_pclk=PCLK_GPIO_NUM;
  c.pin_vsync=VSYNC_GPIO_NUM; c.pin_href=HREF_GPIO_NUM;
  c.pin_sccb_sda=SIOD_GPIO_NUM; c.pin_sccb_scl=SIOC_GPIO_NUM;
  c.pin_pwdn=PWDN_GPIO_NUM; c.pin_reset=RESET_GPIO_NUM;
  c.xclk_freq_hz=20000000; c.pixel_format=PIXFORMAT_JPEG;

  if (psramFound()) {
    // Allocate for the resolution actually in use, NOT for UXGA. Reserving
    // the maximum cost tens of KB of internal DRAM in DMA/line buffers even
    // with the frames themselves in PSRAM, and that shortage is what starves
    // mbedtls and makes socket() fail. Changing resolution re-inits instead.
    c.frame_size    = FRAMESIZES[constrain(g_cam.res_idx, 0, 5)];
    c.jpeg_quality  = constrain(g_cam.quality, 6, 30);
    c.fb_count      = 2;             // free-running DMA: fb_get returns an
    c.fb_location   = CAMERA_FB_IN_PSRAM;
    c.grab_mode     = CAMERA_GRAB_LATEST;   // already-exposed frame instantly
  } else {
    c.frame_size    = FRAMESIZE_SVGA;
    c.jpeg_quality  = 12;
    c.fb_count      = 1;
    c.fb_location   = CAMERA_FB_IN_DRAM;
    c.grab_mode     = CAMERA_GRAB_WHEN_EMPTY;
  }

  for (int attempt = 0; attempt < 3; attempt++) {
    esp_err_t e = esp_camera_init(&c);
    if (e == ESP_OK) {
      applySettings();
      Serial.printf("[CAM] init ok at res_idx=%d, heap=%luK psram=%luK\n",
                    g_cam.res_idx, (unsigned long)(ESP.getFreeHeap() / 1024),
                    (unsigned long)(ESP.getFreePsram() / 1024));
      return true;
    }
    Serial.printf("[CAM] init failed (0x%x), retry %d\n", e, attempt + 1);
    esp_camera_deinit();
    delay(400);
  }
  return false;
}

// Resolution changes now re-init rather than pre-reserving the largest frame.
// Costs ~300 ms on change, saves internal DRAM permanently.
static bool reinitCamera() {
  esp_camera_deinit();
  delay(120);
  g_camOK = initCamera();
  return g_camOK;
}

static uint32_t claimPhotoNumber() {
  uint32_t n;
  xSemaphoreTake(g_nvsMux, portMAX_DELAY);
  n = g_nextNum++;
  prefs.putUInt("next", g_nextNum);
  xSemaphoreGive(g_nvsMux);
  return n;
}

/*
  The one function that matters: grab a frame and get it onto the card.
  Network work never happens here — it is handed to netTask afterwards.
  Returns the photo number in *outNum (0 on total failure).
*/
static bool captureAndStore(uint32_t* outNum, bool queueForSend) {
  *outNum = 0;
  if (!g_camOK) return false;
  if (!xSemaphoreTake(g_camMux, pdMS_TO_TICKS(6000))) return false;
  g_busyCapture = true;

  bool useFlash = g_cam.flash && g_cam.flash_duty > 0;
  if (useFlash) {
    FLASH_WRITE(g_cam.flash_duty);
    // Drop the frames that were exposed before the LED came on.
    for (int i = 0; i < FLASH_SETTLE_FRAMES; i++) {
      camera_fb_t* d = esp_camera_fb_get();
      if (d) esp_camera_fb_return(d);
    }
  }
  camera_fb_t* fb = esp_camera_fb_get();
  if (useFlash) FLASH_WRITE(0);      // LED off before the SD write draws current

  if (!fb || !fb->len) {
    if (fb) esp_camera_fb_return(fb);
    g_camFails++;
    g_busyCapture = false;
    xSemaphoreGive(g_camMux);
    Serial.println("[CAM] capture failed");
    return false;
  }
  g_camFails = 0;

  uint32_t num = claimPhotoNumber();
  bool ok = sdWritePhoto(num, fb->buf, fb->len);

  if (!ok) {
    // Card missing or dead — keep this shot in PSRAM so it is not simply lost.
    g_sdFails++;
    if (g_ramBuf) { free(g_ramBuf); g_ramBuf = nullptr; g_ramLen = 0; }
    g_ramBuf = (uint8_t*)ps_malloc(fb->len);
    if (!g_ramBuf) g_ramBuf = (uint8_t*)malloc(fb->len);
    if (g_ramBuf) { memcpy(g_ramBuf, fb->buf, fb->len); g_ramLen = fb->len; g_ramNum = num; }
  }

  g_lastNum = num;
  g_lastLen = fb->len;
  g_shotTotal++;
  esp_camera_fb_return(fb);
  g_busyCapture = false;
  xSemaphoreGive(g_camMux);

  // Only queue a marker for a photo that actually reached the card — otherwise
  // the marker points at nothing and the uploader has to throw it away. When
  // the write failed the PSRAM fallback above carries the shot instead.
  if (queueForSend && ok) queueAdd(num);
  *outNum = num;
  Serial.printf("[CAM] #%lu  %lu B  sd=%d  heap=%lu\n",
                (unsigned long)num, (unsigned long)g_lastLen, ok,
                (unsigned long)ESP.getFreeHeap());
  return true;
}

