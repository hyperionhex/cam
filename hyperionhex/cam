/*
  WebServer::begin() is void and NetworkServer::begin() bails out silently if
  socket()/bind()/listen() fails, so "I called begin()" proves nothing. The
  real state lives in NetworkServer::_server, which is protected — a two-line
  subclass turns it into something we can actually assert on.
*/
class KewlWebServer : public WebServer {
public:
  explicit KewlWebServer(int port) : WebServer(port) {}
  bool listening() { return (bool)_server; }
};
KewlWebServer server(80);
WiFiMulti   wifiMulti;
Preferences prefs;

TaskHandle_t      g_camTask = nullptr, g_netTask = nullptr;
SemaphoreHandle_t g_camMux, g_sdMux, g_nvsMux;

// The SD lock is recursive: queueAdd() counts the queue while already holding
// it, and the alternative is two variants of every card helper.
#define SD_LOCK(ms) (xSemaphoreTakeRecursive(g_sdMux, pdMS_TO_TICKS(ms)) == pdTRUE)
#define SD_UNLOCK() xSemaphoreGiveRecursive(g_sdMux)

volatile uint32_t g_btnIsrMs   = 0;
volatile bool     g_busyCapture = false;

bool     g_sdOK = false, g_camOK = false, g_apOn = false, g_timeOK = false;
uint32_t g_nextNum = 1, g_oldestNum = 1, g_lastNum = 0, g_lastLen = 0;
uint32_t g_pending = 0, g_sentTotal = 0, g_shotTotal = 0;
uint32_t g_camFails = 0, g_sdFails = 0, g_sendFails = 0;
uint32_t g_bootMs = 0, g_lastActivity = 0;
// The browser only ever claims ONE specific photo (the one it just captured or
// is relaying). It can no longer gate the whole queue.
uint32_t g_claimNum = 0, g_claimUntil = 0;
uint32_t g_firstFailMs = 0;   // when the current run of send failures started
