// IRAM_ATTR lives on the forward declaration above; repeating it here would
// emit a second .iram1 section and warn.
static void btnISR() {
  uint32_t now = millis();
  if (now - g_btnIsrMs < BTN_LOCKOUT_MS) return;   // bounce / double-shot guard
  g_btnIsrMs = now;
  BaseType_t hpw = pdFALSE;
  vTaskNotifyGiveFromISR(g_camTask, &hpw);
  if (hpw) portYIELD_FROM_ISR();
}

static void camTaskFn(void*) {
  for (;;) {
    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
    // Confirm the line is genuinely held — rejects EMI spikes on a long wire
    // without costing anything a human could feel.
    vTaskDelay(pdMS_TO_TICKS(BTN_CONFIRM_MS));
    if (digitalRead(BUTTON_PIN) != LOW) continue;

    ledSet(true);                       // instant feedback the moment it fires
    uint32_t num = 0;
    bool ok = captureAndStore(&num, true);
    ledSet(false);
    blink(ok ? 1 : 5);
    g_lastActivity = millis();
    if (ok) xTaskNotifyGive(g_netTask); // wake the uploader, do not wait for it
  }
}

