// Returns true if a command was acted on (caller should re-run the drain).
static bool tgRunCommand(const String& text) {
  String c = text;
  c.trim();
  int sp = c.indexOf(' ');
  String verb = (sp < 0) ? c : c.substring(0, sp);
  String arg  = (sp < 0) ? String() : c.substring(sp + 1);
  verb.toLowerCase();
  arg.trim(); arg.toLowerCase();
  int at = verb.indexOf('@');            // "/photo@KewlCamBot" in groups
  if (at >= 0) verb = verb.substring(0, at);

  if (verb == "/photo" || verb == "/p" || verb == "/pic" || verb == "/shoot") {
    uint32_t num = 0;
    blink(1);
    if (captureAndStore(&num, true)) {
      Serial.printf("[BOT] /photo -> #%lu\n", (unsigned long)num);
      return true;                        // the drain loop delivers it
    }
    tgSendText("Capture failed - camera did not return a frame.");
    return false;
  }
  if (verb == "/status" || verb == "/s") { tgCmdStatus(); return false; }
  if (verb == "/networks" || verb == "/net") {
    int best; char bs[33] = {0};
    int idx = scanForBest(&best, bs, sizeof bs);
    char m[300];
    if (idx < 0) {
      snprintf(m, sizeof m, "Scan found none of your saved networks in range.");
    } else {
      snprintf(m, sizeof m,
               "Currently on: %s (%d dBm)\nStrongest saved: %s (%d dBm)\n\n%s",
               WiFi.SSID().c_str(), WiFi.RSSI(), bs, best,
               best > WiFi.RSSI() + ROAM_MARGIN_DBM
                 ? "A better network is in range - the camera will move to it."
                 : "Already on the best one available here.");
    }
    tgSendText(m);
    return false;
  }
  if (verb == "/selftest" || verb == "/test") {
    char st[80], m[420];
    bool ok = webSelfTest(st, sizeof st);
    snprintf(m, sizeof m,
             "Web server self-test: %s\n%s\nAddress: http://%s/\n\n%s",
             ok ? "PASS" : "FAIL", st, WiFi.localIP().toString().c_str(),
             ok ? "The camera is serving pages on that address. A device that "
                  "still cannot load it is on another network, or the router "
                  "is blocking device-to-device traffic."
                : "The fault is inside the camera - send me this message.");
    tgSendText(m);
    return false;
  }
  if (verb == "/ap") {
    char m[200];
    if (arg == "off") {
      g_apManual = false;
      apStop();
      tgSendText("AP off. Radio dedicated to the uplink.");
    } else {
      g_apManual = true;                 // survives the auto-shutdown check
      apStart();
      snprintf(m, sizeof m,
               "AP on.\nSSID: %s\nPassword: %s\nThen open http://192.168.4.1/\n"
               "Send /ap off when done - it shares the radio with the uplink.",
               AP_SSID, (AP_PASS && strlen(AP_PASS) >= 8) ? AP_PASS : "(open)");
      tgSendText(m);
    }
    return false;
  }
  if (verb == "/ip") {
    // Everything needed to tell "different networks" from "same network but
    // blocked": compare Network and Gateway with the phone's WiFi details.
    char m[280];
    snprintf(m, sizeof m,
             "Web UI: http://%s/\n"
             "Network: %s\nGateway: %s\nMask: %s\nMAC: %s\nSignal: %d dBm\n"
             "AP: %s\n\n"
             "If your phone's gateway differs, you are on a different network "
             "and this address cannot reach the camera.",
             WiFi.localIP().toString().c_str(),
             WiFi.SSID().c_str(),
             WiFi.gatewayIP().toString().c_str(),
             WiFi.subnetMask().toString().c_str(),
             WiFi.macAddress().c_str(),
             WiFi.RSSI(),
             g_apOn ? "on (192.168.4.1)" : "off - send /ap on");
    tgSendText(m);
    return false;
  }
  if (verb == "/flash") {
    if (arg == "on")       g_cam.flash = 1;
    else if (arg == "off") g_cam.flash = 0;
    else                   g_cam.flash = !g_cam.flash;
    prefsSaveCam();
    tgSendText(g_cam.flash ? "Flash ON (adds ~150 ms to the shutter)"
                           : "Flash OFF (fastest shutter)");
    return false;
  }
  if (verb == "/last") {
    if (!g_lastNum) { tgSendText("No photos taken yet."); return false; }
    queueAdd(g_lastNum);
    return true;
  }
  if (verb == "/retry") {
    g_sendFails = 0; g_firstFailMs = 0; g_claimUntil = 0;
    g_pending = queueCount();
    char m[64];
    snprintf(m, sizeof m, "Retrying %lu queued photo(s).", (unsigned long)g_pending);
    tgSendText(m);
    return true;
  }
  if (verb == "/help" || verb == "/start") {
    tgSendText("KewlCam commands\n"
               "/photo - take and send a photo\n"
               "/last - resend the most recent photo\n"
               "/status - card, network, queue, uptime\n"
               "/flash on|off - toggle the LED\n"
               "/retry - flush the pending queue\n"
               "/ap on|off - turn the KewlCam hotspot on for the web UI\n"
               "/networks - signal of every saved network here\n"
               "/selftest - check the web server is really answering\n"
               "/ip - web UI address");
    return false;
  }
  return false;                            // not a command; ignore silently
}

// One long-poll cycle. Returns true if a command ran.
static bool tgPollCommands() {
  if (WiFi.status() != WL_CONNECTED) return false;
  if (!tgConnect()) return false;

  char path[220];
  if (!g_tgOffsetInit)
    snprintf(path, sizeof path, "/bot%s/getUpdates?offset=-1&limit=1&timeout=0", BOT_TOKEN);
  else
    snprintf(path, sizeof path, "/bot%s/getUpdates?offset=%lld&limit=1&timeout=%d",
             BOT_TOKEN, (long long)g_tgOffset, BOT_POLL_SECONDS);

  g_tg.printf("GET %s HTTP/1.1\r\n", path);
  g_tg.print(F("Host: api.telegram.org\r\nConnection: keep-alive\r\n\r\n"));

  bool reusable = false;
  String body;
  bool ok = tgReadReply(&reusable, &body, true);
  if (!reusable) tgClose();
  g_tgIdleSince = millis();
  if (!ok) return false;

  int64_t uid = jsonNum(body, "\"update_id\":");
  if (uid == INT64_MIN) return false;      // empty result, nothing waiting
  g_tgOffset = uid + 1;
  tgSaveOffset();

  // First run ever: adopt the latest id without executing, so a backlog of
  // old messages does not fire off a burst of photos.
  if (!g_tgOffsetInit) {
    g_tgOffsetInit = true;
    Serial.printf("[BOT] listening, starting at update %lld\n", (long long)g_tgOffset);
    return false;
  }

  int64_t from = jsonNumIn(body, "\"chat\"", "\"id\"");
  if (String((long long)from) != String(CHAT_ID)) {
    Serial.printf("[BOT] ignoring message from chat %lld\n", (long long)from);
    return false;
  }

  // Drop anything that has been sitting on Telegram's servers while the
  // camera was offline — acting on a two-hour-old /photo is just confusing.
  int64_t date = jsonNum(body, "\"date\":");
  if (g_timeOK && date != INT64_MIN) {
    int64_t age = (int64_t)time(nullptr) - date;
    if (age > 300) {
      Serial.printf("[BOT] skipping stale command (%llds old)\n", (long long)age);
      return false;
    }
  }

  String text = jsonStr(body, "\"text\"");
  if (!text.length()) return false;
  Serial.printf("[BOT] command: %s\n", text.c_str());
  g_lastActivity = millis();
  return tgRunCommand(text);
}
#endif  // BOT_COMMANDS

// 1 = delivered, 0 = try again later, -1 = the file is gone, stop retrying it.
static int tgSendQueued(uint32_t num) {
  char p[40]; photoPath(p, sizeof p, num);
  if (!SD_LOCK(4000)) return 0;
  File f = SD_MMC.open(p, FILE_READ);
  SD_UNLOCK();
  if (!f) {
    Serial.printf("[TG]  #%lu missing on card — dropping marker\n", (unsigned long)num);
    return -1;
  }
  bool ok = tgSend(num, &f, nullptr, 0);
  f.close();
  return ok ? 1 : 0;
}

/*═══════════════════════════════════════════════════════════════════════╗
║  10. Network task — WiFi roaming + queue drain                         ║
╚═══════════════════════════════════════════════════════════════════════*/

static void apStart() {
  if (g_apOn) return;
  WiFi.mode(WIFI_AP_STA);
  const char* pw = (AP_PASS && strlen(AP_PASS) >= 8) ? AP_PASS : nullptr;
  WiFi.softAP(AP_SSID, pw);
  g_apOn = true;
  g_rebindServer = true;      // same reason as apStop(): the mode just changed
  Serial.printf("[AP]  \"%s\" up at 192.168.4.1%s\n", AP_SSID, pw ? "" : " (open)");
}
static void apStop() {
  if (!g_apOn) return;
  WiFi.softAPdisconnect(true);
  g_apOn = false;
  // softAPdisconnect(true) changes the WiFi mode underneath us, which
  // recreates the netifs and leaves the listening socket pointing at nothing.
  // Rebinding is not optional here.
  g_rebindServer = true;
  Serial.println("[AP]  down — radio dedicated to the uplink, rebinding server");
}

/*
  Asks the camera's own web server for "/" over TCP, from netTask, while
  loop() serves it. This settles the "can't load the page" question without
  needing a phone or a laptop at all:
    PASS -> the server is listening and replying on this exact IP, so anything
            that still cannot reach it is being blocked by the network.
    FAIL -> the fault is in here, and the reason string says which half.
*/
/*
  Verifies the web server over LOOPBACK, never over our own LAN address.
  lwIP does not route a device's own unicast address back to itself, so
  connecting to WiFi.localIP() is refused even when the server is perfectly
  healthy — that false negative sent me chasing a working server for two
  rounds. 127.0.0.1 exercises the same accept path and tells the truth.

  A PASS here means the server accepts and answers HTTP. It says nothing
  about whether packets from your phone survive the air gap — read RSSI for
  that.
*/
static bool webSelfTest(char* detail, size_t n) {
  if (!server.listening()) { snprintf(detail, n, "listening flag is FALSE"); return false; }
  WiFiClient c;
  if (!c.connect(IPAddress(127, 0, 0, 1), 80, 3000)) {
    snprintf(detail, n, "loopback refused despite listening flag");
    return false;
  }
  c.print(F("GET / HTTP/1.0\r\nHost: self\r\nConnection: close\r\n\r\n"));
  String line;
  uint32_t t0 = millis();
  while (millis() - t0 < 6000) {
    if (c.available()) {
      char ch = (char)c.read();
      if (ch == '\n') break;
      if (ch != '\r' && line.length() < 60) line += ch;
    } else if (!c.connected()) {
      break;
    } else {
      vTaskDelay(pdMS_TO_TICKS(5));
    }
  }
  c.stop();
  if (!line.length()) { snprintf(detail, n, "connected but no reply (loop stalled?)"); return false; }
  snprintf(detail, n, "%s", line.c_str());
  return line.indexOf("200") >= 0;
}

/*
  Scans and reports the RSSI of every configured network it can see, returning
  the index of the strongest. With three networks saved, the camera may well be
  clinging to the weakest one simply because that is what it found first.
*/
static int scanForBest(int* bestRssi, char* bestSsid, size_t n) {
  int found = -1;
  *bestRssi = -127;
  int cnt = WiFi.scanNetworks(false, false);
  for (int i = 0; i < cnt; i++) {
    String s = WiFi.SSID(i);
    int r = WiFi.RSSI(i);
    for (int k = 0; k < 3; k++) {
      if (g_ssid[k][0] && s.equals(g_ssid[k])) {
        Serial.printf("[STA]   known network \"%s\"  %d dBm\n", s.c_str(), r);
        if (r > *bestRssi) {
          *bestRssi = r;
          found = k;
          if (bestSsid && n) strlcpy(bestSsid, s.c_str(), n);
        }
      }
    }
  }
  WiFi.scanDelete();
  return found;
}

// Weak link? See whether one of the other saved networks is materially
// better and move to it. Only runs when the current link is already poor,
// because the scan itself briefly interrupts traffic.
static void maybeRoam() {
  static uint32_t lastCheck = 0;
  if (millis() - lastCheck < 120000UL) return;
  lastCheck = millis();
  int cur = WiFi.RSSI();
  if (cur > ROAM_TRIGGER_DBM) return;

  Serial.printf("[STA] link at %d dBm — checking for a better known network\n", cur);
  int best; char bs[33] = {0};
  int idx = scanForBest(&best, bs, sizeof bs);
  if (idx >= 0 && best > cur + ROAM_MARGIN_DBM && !WiFi.SSID().equals(bs)) {
    Serial.printf("[STA] roaming to \"%s\" (%d dBm, was %d)\n", bs, best, cur);
    WiFi.begin(g_ssid[idx], g_pass[idx]);
  } else {
    Serial.println("[STA] nothing better in range — this is as good as it gets here");
  }
}

// The link, not the server, is what decides whether a page ever loads.
static void reportLinkQuality() {
  int rssi = WiFi.RSSI();
  const char* verdict = rssi > -60 ? "good"
                      : rssi > -70 ? "usable"
                      : rssi > -80 ? "WEAK - expect stalls and timeouts"
                                   : "UNUSABLE";
  Serial.printf("[STA] link quality: %d dBm (%s)\n", rssi, verdict);
  if (rssi <= -70) {
    Serial.println(
      "      Check the ANTENNA JUMPER on the underside of the ESP32-CAM: the\n"
      "      three pads beside the gold PCB antenna. Bridged toward the IPEX\n"
      "      socket with no external antenna fitted collapses range - this is\n"
      "      the most common cause of a weak ESP32-CAM link. Otherwise move it\n"
      "      closer to the router and re-check.");
  }
}

// Disconnect reasons are the single most useful thing in the log when uploads
// go slow: reason 2/15 = auth/handshake, 4 = assoc expired (weak signal),
// 8/200-205 = the AP dropped us, 201 = AP not found.
static void onWiFiEvent(WiFiEvent_t ev, WiFiEventInfo_t info) {
  if (ev == ARDUINO_EVENT_WIFI_STA_DISCONNECTED) {
    g_wifiDrops++;
    Serial.printf("[STA] DISCONNECTED (reason %d, drop #%lu)\n",
                  info.wifi_sta_disconnected.reason, (unsigned long)g_wifiDrops);
  } else if (ev == ARDUINO_EVENT_WIFI_STA_GOT_IP) {
    Serial.printf("[STA] got IP %s\n", WiFi.localIP().toString().c_str());
  }
}

static void syncTime() {
  configTime(0, 0, "pool.ntp.org", "time.google.com");
  setenv("TZ", TZ_INFO, 1);
  tzset();
  for (int i = 0; i < 20 && !g_timeOK; i++) {
    if (time(nullptr) > 1700000000) g_timeOK = true;
    else vTaskDelay(pdMS_TO_TICKS(250));
  }
  if (g_timeOK) Serial.println("[NTP] clock set — SD files get real timestamps");
}

static void netTaskFn(void*) {
  uint32_t backoff = 2000, lastTry = 0, lastOnline = 0;
  int quickTries = 0;
  bool wasUp = false;

  for (;;) {
    bool up = (WiFi.status() == WL_CONNECTED);

    if (!up) {
      if (millis() - lastTry > backoff) {
        lastTry = millis();
        if (!g_apOn) apStart();                 // always reachable while hunting

        // A plain reconnect to the AP we were just on takes ~1 s. A full
        // wifiMulti scan takes 3-5 s and jams the radio while it runs, so
        // only fall back to it when the quick path has failed twice.
        bool got = false;
        if (quickTries < 2 && WiFi.SSID().length()) {
          Serial.printf("[STA] quick reconnect to \"%s\"\n", WiFi.SSID().c_str());
          WiFi.reconnect();
          for (int i = 0; i < 30 && !got; i++) {
            vTaskDelay(pdMS_TO_TICKS(100));
            got = (WiFi.status() == WL_CONNECTED);
          }
          quickTries++;
        }
        if (!got) {
          Serial.println("[STA] scanning for a known network...");
          got = (wifiMulti.run(9000) == WL_CONNECTED);
          quickTries = 0;
        }
        if (got) {
          backoff = 2000;
        } else {
          // Cap at 15 s, not 60. A minute of dead air per retry is how a
          // marginal link turns into ten-minute delivery times.
          backoff = backoff < 15000 ? backoff * 2 : 15000;
          Serial.printf("[STA] no luck, retry in %lu s\n", (unsigned long)backoff / 1000);
        }
      }
    } else {
      quickTries = 0;
      lastOnline = millis();
      if (!wasUp) {
        wasUp = true;
        String ip = WiFi.localIP().toString();
        Serial.printf("\n[STA] connected to \"%s\"  RSSI=%d\n", WiFi.SSID().c_str(), WiFi.RSSI());
        Serial.printf(">>>>>  http://%s/   <<<<<\n", ip.c_str());
        Serial.printf("      gateway %s  mask %s  mac %s\n\n",
                      WiFi.gatewayIP().toString().c_str(),
                      WiFi.subnetMask().toString().c_str(),
                      WiFi.macAddress().c_str());

        // mDNS has to be (re)registered now that the STA holds an address,
        // otherwise kewlcam.local only ever answers on the AP interface.
        MDNS.end();
        if (MDNS.begin("kewlcam")) {
          MDNS.addService("http", "tcp", 80);
          Serial.println("[mDNS] kewlcam.local registered on the STA interface");
        }

        // The listening socket was bound in setup(), before this interface
        // existed. Rebind it now so there is no doubt it accepts on the LAN.
        g_rebindServer = true;

        if (!g_timeOK) syncTime();

        // Plenty of phone browsers (Chrome/Kiwi on Android among them) will
        // not resolve .local at all. Put the raw URL somewhere it cannot be
        // missed instead of relying on discovery.
        // Let loop() finish the rebind, then prove the server actually answers.
        // begin() cannot report failure, so the self-test IS the error check —
        // if it fails, free what we can and rebind again.
        char st[80];
        bool webOK = false;
        for (int attempt = 0; attempt < 4 && !webOK; attempt++) {
          vTaskDelay(pdMS_TO_TICKS(500));
          webOK = webSelfTest(st, sizeof st);
          if (webOK) break;
          Serial.printf("[Web] self-test FAIL (%s) heap=%luK — rebinding (try %d)\n",
                        st, (unsigned long)(ESP.getFreeHeap() / 1024), attempt + 1);
          tgClose();                 // hand mbedtls' ~40 KB back before retrying
          g_rebindServer = true;
        }
        Serial.printf("[Web] self-test: %s (%s)\n", webOK ? "PASS" : "FAIL", st);
        reportLinkQuality();

        // Only when the address actually changes, so a flapping link cannot
        // turn into a stream of identical messages.
        static String announced;
        if (announced != ip) {
          char msg[420];
          snprintf(msg, sizeof msg,
                   "KewlCam online\nNetwork: %s\nWeb UI: http://%s/\nGateway: %s\n"
                   "Signal: %d dBm (%s)\nQueued: %lu\nWeb server: %s\n%s",
                   WiFi.SSID().c_str(), ip.c_str(),
                   WiFi.gatewayIP().toString().c_str(),
                   WiFi.RSSI(),
                   WiFi.RSSI() > -60 ? "good" : WiFi.RSSI() > -70 ? "usable" : "WEAK",
                   (unsigned long)g_pending,
                   webOK ? "listening OK" : st,
                   WiFi.RSSI() <= -70
                     ? "Signal is weak - that is what makes pages time out and "
                       "uploads crawl. Check the antenna jumper on the underside "
                       "of the board, or move it nearer the router."
                     : "");
          if (tgSendText(msg)) announced = ip;
        }
      }

      // Card-less fallback: one shot may be sitting in PSRAM.
      if (g_ramBuf && g_ramLen) {
        if (tgSend(g_ramNum, nullptr, g_ramBuf, g_ramLen)) {
          g_sentTotal++; prefsSaveCounters();
          free(g_ramBuf); g_ramBuf = nullptr; g_ramLen = 0;
          blink(2);
        }
      }

      // Drain the on-card queue, oldest first, back to back. Nothing except a
      // per-photo browser claim is allowed to hold this up.
      if (g_sdOK && g_pending) {
        uint32_t n = queueFirstSendable();
        if (n) {
          int r = tgSendQueued(n);
          if (r != 0) {                          // delivered, or gone for good
            queueRemove(n);
            if (r > 0) { g_sentTotal++; blink(2); }
            g_sendFails = 0; g_firstFailMs = 0;
            prefsSaveCounters();
            g_lastActivity = millis();
            continue;                            // straight on to the next one
          }
          g_sendFails++;
          if (!g_firstFailMs) g_firstFailMs = millis();
          // 1, 2, 4, 8 s ... capped at 15. Fast enough to ride out a blip,
          // slow enough not to hammer a genuinely dead uplink.
          uint32_t wait = 1000UL << (g_sendFails < 4 ? g_sendFails - 1 : 3);
          vTaskDelay(pdMS_TO_TICKS(wait > 15000 ? 15000 : wait));
        } else {
          g_pending = queueCount();              // marker vanished, resync
        }
      }

      maybeRoam();      // must sit outside the BOT_COMMANDS branches

#if BOT_COMMANDS
      // Only once the queue is empty — delivering photos always outranks
      // listening for commands. The poll aborts itself the moment a new
      // photo is queued, so the button never waits on it.
      if (!g_pending) {
        // Under memory pressure a held-open TLS session is what tips socket()
        // into failing, which silently kills the web server. Commands get a
        // little slower; the web UI stays alive. That is the right trade.
        if (ESP.getFreeHeap() < 60000) {
          tgClose();
          vTaskDelay(pdMS_TO_TICKS(3000));
        } else if (tgPollCommands()) {
          continue;
        }
      }
#else
      // Do not sit on an idle TLS session; it is ~40 KB of heap.
      if (g_tg.connected() && millis() - g_tgIdleSince > 20000) tgClose();
#endif
    }

    if (wasUp && !up) { wasUp = false; Serial.println("[STA] link lost"); }

#if AP_AUTO_OFF
    if (up && g_apOn && !g_apManual && WiFi.softAPgetStationNum() == 0 &&
        millis() - g_bootMs > AP_GRACE_MS) apStop();
#endif

    // WiFi stack wedged with credentials that should work → let the watchdog
    // path recycle it rather than sitting dark forever.
    if (!up && lastOnline && millis() - lastOnline > 900000UL) {
      Serial.println("[STA] 15 min offline — restarting WiFi stack");
      lastOnline = millis();
      WiFi.disconnect(true);
      vTaskDelay(pdMS_TO_TICKS(500));
      WiFi.mode(WIFI_AP_STA);
      apStart();
    }

    // Sleep until something happens, or 1 s, whichever is first.
    ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(1000));
  }
}

/*═══════════════════════════════════════════════════════════════════════╗
║  11. HTTP handlers                                                     ║
╚═══════════════════════════════════════════════════════════════════════*/

static void touch() { g_lastActivity = millis(); }

// Can the camera deliver on its own? If not, an open browser relays for it.
static bool offloadWanted();

static void handleRoot() {
  touch();
  // Decisive diagnostic: if you try to load the page and this line never
  // appears, the request never reached the camera at all — the network is
  // dropping it, and no firmware change can help. If it DOES appear, the
  // camera answered and the problem is on the browser side.
  Serial.printf("[Web] GET / from %s\n", server.client().remoteIP().toString().c_str());
  server.sendHeader("Cache-Control", "max-age=60");
  server.send_P(200, "text/html", PAGE_HTML);
}

static void handleConfig() {
  touch();
  char b[256];
  snprintf(b, sizeof b, "{\"token\":\"%s\",\"chat\":\"%s\"}", BOT_TOKEN, CHAT_ID);
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", b);
}

/*
  Capture → SD → stream back. The photo IS queued, and the browser clears the
  marker via /sent once its own upload succeeds. Queuing first means closing
  the page, losing the tab, or any JS error leaves the photo pending rather
  than silently unsent — the camera then delivers it itself.
*/
static void handlePhoto() {
  touch();
  uint32_t num = 0;
  if (!captureAndStore(&num, true)) { server.send(500, "text/plain", "capture failed"); return; }
  // Give the browser first go at this one; netTask picks it up if it fails.
  g_claimNum = num;
  g_claimUntil = millis() + 30000;
  server.sendHeader("Cache-Control", "no-store");
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("X-Photo-Num", String(num));

  if (g_sdOK) {
    char p[40]; photoPath(p, sizeof p, num);
    if (SD_LOCK(4000)) {
      File f = SD_MMC.open(p, FILE_READ);
      if (f) { server.streamFile(f, "image/jpeg"); f.close(); SD_UNLOCK(); return; }
      SD_UNLOCK();
    }
  }
  if (g_ramBuf && g_ramNum == num) {
    server.send_P(200, "image/jpeg", (const char*)g_ramBuf, g_ramLen);
    return;
  }
  server.send(500, "text/plain", "stored but unreadable");
}

static void handleFile() {
  touch();
  if (!server.hasArg("n")) { server.send(400, "text/plain", "n?"); return; }
  uint32_t n = server.arg("n").toInt();
  if (g_ramBuf && g_ramNum == n) {
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send_P(200, "image/jpeg", (const char*)g_ramBuf, g_ramLen);
    return;
  }
  if (!g_sdOK) { server.send(503, "text/plain", "no sd"); return; }
  char p[40]; photoPath(p, sizeof p, n);
  if (!SD_LOCK(4000)) { server.send(503, "text/plain", "busy"); return; }
  File f = SD_MMC.open(p, FILE_READ);
  if (!f) { SD_UNLOCK(); server.send(404, "text/plain", "gone"); return; }
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Cache-Control", "max-age=86400");
  server.streamFile(f, "image/jpeg");
  f.close();
  SD_UNLOCK();
  // A browser pulling a still-queued photo is relaying that one right now.
  // Claim only that number, and only briefly.
  if (offloadWanted()) { g_claimNum = n; g_claimUntil = millis() + 30000; }
}

static void handleList() {
  touch();
  int want = server.hasArg("n") ? server.arg("n").toInt() : 9;
  want = constrain(want, 1, 40);
  String j = "{\"list\":[";
  int c = 0;
  for (uint32_t n = g_lastNum; n >= g_oldestNum && n > 0 && c < want; n--) {
    if (c) j += ',';
    j += n;
    c++;
  }
  j += "]}";
  server.send(200, "application/json", j);
}

/*
  Ask the browser to relay only when the camera genuinely cannot deliver:
  it is off the network, or its sends have been failing for a sustained
  stretch. A couple of transient failures used to latch this on forever.
*/
static bool offloadWanted() {
  if (WiFi.status() != WL_CONNECTED) return true;
  return g_firstFailMs && (millis() - g_firstFailMs > 45000);
}

static void handleStatus() {
  touch();
  bool up = (WiFi.status() == WL_CONNECTED);
  bool off = offloadWanted();
  String list = "[";
  if (off && g_sdOK && g_pending) {
    // Hand the browser a short batch and hold netTask off it while it works.
    uint32_t batch[5]; int n = 0;
    g_pending = queueScan(nullptr, 0, batch, 5, &n);
    for (int i = 0; i < n; i++) { if (i) list += ','; list += batch[i]; }
  }
  list += ']';

  char b[768];
  snprintf(b, sizeof b,
    "{\"sd\":%d,\"wifi\":%d,\"ssid\":\"%s\",\"rssi\":%d,\"ip\":\"%s\","
    "\"pending\":%lu,\"last\":%lu,\"shot\":%lu,\"sent\":%lu,"
    "\"heap\":%lu,\"up\":%lu,\"used\":%lu,\"total\":%lu,\"offload\":%d,"
    "\"cam\":{\"brightness\":%d,\"contrast\":%d,\"sat\":%d,\"sharpness\":%d,"
    "\"wb_mode\":%d,\"hmirror\":%d,\"vflip\":%d,\"quality\":%d,\"res_idx\":%d,"
    "\"flash\":%d,\"flash_duty\":%d},\"list\":%s}",
    g_sdOK ? 1 : 0, up ? 1 : 0,
    up ? WiFi.SSID().c_str() : AP_SSID, up ? WiFi.RSSI() : 0,
    up ? WiFi.localIP().toString().c_str() : "192.168.4.1",
    (unsigned long)g_pending, (unsigned long)g_lastNum,
    (unsigned long)g_shotTotal, (unsigned long)g_sentTotal,
    (unsigned long)ESP.getFreeHeap(), (unsigned long)(millis() / 1000),
    (unsigned long)(g_sdOK ? SD_MMC.usedBytes() / (1024ULL * 1024ULL) : 0),
    (unsigned long)(g_sdOK ? SD_MMC.totalBytes() / (1024ULL * 1024ULL) : 0),
    off ? 1 : 0,
    g_cam.brightness, g_cam.contrast, g_cam.sat, g_cam.sharpness,
    g_cam.wb_mode, g_cam.hmirror, g_cam.vflip, g_cam.quality, g_cam.res_idx,
    g_cam.flash, g_cam.flash_duty, list.c_str());
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", b);
}

static void handleQueueAdd() {
  touch();
  if (server.hasArg("n")) queueAdd(server.arg("n").toInt());
  server.send(200, "application/json", "{\"ok\":true}");
}
static void handleSent() {
  touch();
  if (server.hasArg("n")) {
    queueRemove(server.arg("n").toInt());
    g_sentTotal++; prefsSaveCounters(); blink(2);
    // The browser got one through, so stop treating the link as broken —
    // otherwise offload mode would latch on until the camera itself succeeds.
    g_sendFails = 0;
    g_firstFailMs = 0;
    g_claimUntil = 0;
  }
  server.send(200, "application/json", "{\"ok\":true}");
}
static void handleRetry() {
  touch();
  g_sendFails = 0;
  g_firstFailMs = 0;
  g_claimUntil = 0;
  g_pending = queueCount();
  if (g_netTask) xTaskNotifyGive(g_netTask);
  server.send(200, "application/json", "{\"ok\":true}");
}

static void handleSettings() {
  touch();
  sensor_t* s = esp_camera_sensor_get();
  if (!s) { server.send(503, "text/plain", "no sensor"); return; }
  if (!xSemaphoreTake(g_camMux, pdMS_TO_TICKS(3000))) { server.send(503, "text/plain", "busy"); return; }
  bool settle = false;
  if (server.hasArg("br"))  { g_cam.brightness = constrain(server.arg("br").toInt(), -2, 2);  s->set_brightness(s, g_cam.brightness); }
  if (server.hasArg("con")) { g_cam.contrast   = constrain(server.arg("con").toInt(), -2, 2); s->set_contrast(s, g_cam.contrast); }
  if (server.hasArg("sat")) { g_cam.sat        = constrain(server.arg("sat").toInt(), -2, 2); s->set_saturation(s, g_cam.sat); }
  if (server.hasArg("shp")) { g_cam.sharpness  = constrain(server.arg("shp").toInt(), -3, 3); s->set_sharpness(s, g_cam.sharpness); }
  if (server.hasArg("wb"))  { g_cam.wb_mode    = constrain(server.arg("wb").toInt(), 0, 4);   s->set_wb_mode(s, g_cam.wb_mode); settle = true; }
  if (server.hasArg("hm"))  { g_cam.hmirror    = server.arg("hm").toInt() ? 1 : 0;            s->set_hmirror(s, g_cam.hmirror); }
  if (server.hasArg("vf"))  { g_cam.vflip      = server.arg("vf").toInt() ? 1 : 0;            s->set_vflip(s, g_cam.vflip); }
  if (server.hasArg("q"))   { g_cam.quality    = constrain(server.arg("q").toInt(), 6, 30);   s->set_quality(s, g_cam.quality); }
  if (server.hasArg("fx"))  { g_cam.effect     = constrain(server.arg("fx").toInt(), 0, 6);   s->set_special_effect(s, g_cam.effect); settle = true; }
  if (server.hasArg("fl"))  { g_cam.flash      = server.arg("fl").toInt() ? 1 : 0; }
  if (server.hasArg("fd"))  { g_cam.flash_duty = constrain(server.arg("fd").toInt(), 0, 255); }
  bool resChanged = false;
  if (server.hasArg("res")) {
    int want = constrain(server.arg("res").toInt(), 0, 5);
    resChanged = (want != g_cam.res_idx);
    g_cam.res_idx = want;
  }
  // Buffers are sized for the current resolution, so growing needs a re-init.
  if (resChanged) reinitCamera();
  xSemaphoreGive(g_camMux);
  if (settle) delay(120);
  g_cfgDirtyAt = millis();            // NVS write is debounced in loop()
  server.send(200, "application/json", "{\"ok\":true}");
}

static void handleWifiGet() {
  touch();
  String j = "{\"nets\":[";
  for (int i = 0; i < 3; i++) {
    if (i) j += ',';
    j += "{\"ssid\":\"" + String(g_ssid[i]) + "\",\"set\":" + (g_pass[i][0] ? "true" : "false") + "}";
  }
  j += "]}";
  server.send(200, "application/json", j);
}
// Async scan so the web server is never blocked for the 2-3 s a scan takes.
// Poll it: first call starts one, later calls return the result.
static void handleScan() {
  touch();
  int n = WiFi.scanComplete();
  if (n == WIFI_SCAN_RUNNING) {
    server.send(200, "application/json", "{\"scanning\":true,\"nets\":[]}");
    return;
  }
  if (n < 0) {
    WiFi.scanNetworks(true, false);
    server.send(200, "application/json", "{\"scanning\":true,\"nets\":[]}");
    return;
  }
  String j = "{\"scanning\":false,\"nets\":[";
  int c = 0;
  for (int i = 0; i < n && c < 20; i++) {
    String s = WiFi.SSID(i);
    if (!s.length()) continue;
    s.replace("\\", "\\\\");
    s.replace("\"", "\\\"");
    if (c) j += ',';
    j += "{\"s\":\"" + s + "\",\"r\":" + String(WiFi.RSSI(i)) + "}";
    c++;
  }
  j += "]}";
  WiFi.scanDelete();
  server.send(200, "application/json", j);
}

static void handleWifiSet() {
  touch();
  if (!xSemaphoreTake(g_nvsMux, pdMS_TO_TICKS(2000))) { server.send(503, "text/plain", "busy"); return; }
  for (int i = 0; i < 3; i++) {
    char ks[8], kp[8];
    snprintf(ks, sizeof ks, "s%d", i);
    snprintf(kp, sizeof kp, "p%d", i);
    if (server.hasArg(ks)) prefs.putString(ks, server.arg(ks));
    if (server.hasArg(kp)) prefs.putString(kp, server.arg(kp));
  }
  xSemaphoreGive(g_nvsMux);
  server.send(200, "application/json", "{\"ok\":true,\"reboot\":true}");
  delay(300);
  ESP.restart();                       // simplest way to rebuild the AP list
}

static void handleReboot() {
  server.send(200, "text/plain", "rebooting");
  delay(200);
  ESP.restart();
}

static void handleUpdateDone() {
  server.send(200, "text/plain", Update.hasError() ? "FAIL" : "OK — rebooting");
  delay(300);
  ESP.restart();
}
static void handleUpdateUpload() {
  HTTPUpload& u = server.upload();
  if (u.status == UPLOAD_FILE_START) {
    Serial.printf("[OTA] start: %s\n", u.filename.c_str());
    s_btnArmed = false;
    detachInterrupt(digitalPinToInterrupt(BUTTON_PIN));
    if (g_camTask) vTaskSuspend(g_camTask);
    if (g_netTask) vTaskSuspend(g_netTask);
    FLASH_WRITE(0);
    esp_camera_deinit();
    SD_MMC.end();
    if (g_ramBuf) { free(g_ramBuf); g_ramBuf = nullptr; g_ramLen = 0; }
    if (!Update.begin(UPDATE_SIZE_UNKNOWN)) Update.printError(Serial);
  } else if (u.status == UPLOAD_FILE_WRITE) {
    esp_task_wdt_reset();              // a 1.5 MB upload outlasts the WDT window
    if (Update.write(u.buf, u.currentSize) != u.currentSize) Update.printError(Serial);
  } else if (u.status == UPLOAD_FILE_END) {
    if (Update.end(true)) Serial.printf("[OTA] done: %u bytes\n", u.totalSize);
    else Update.printError(Serial);
  }
}

/*═══════════════════════════════════════════════════════════════════════╗
║  12. Setup                                                             ║
╚═══════════════════════════════════════════════════════════════════════*/

void setup() {
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);   // ESP32-CAM false-trips this
  setCpuFrequencyMhz(CPU_MHZ);
  Serial.begin(115200);
  Serial.setDebugOutput(false);
  delay(80);
  Serial.println("\n\n===== KewlCam v2 =====");
  g_bootMs = millis();
  Serial.printf("[MEM] boot          heap=%luK\n", (unsigned long)(ESP.getFreeHeap() / 1024));

  pinMode(STATUS_LED_PIN, OUTPUT);
  ledSet(true);                                // solid = booting

  g_camMux = xSemaphoreCreateMutex();
  g_sdMux  = xSemaphoreCreateRecursiveMutex();
  g_nvsMux = xSemaphoreCreateMutex();

  prefsLoad();

  g_camOK = initCamera();
  Serial.printf("[CAM] %s  psram=%s\n", g_camOK ? "ready" : "FAILED",
                psramFound() ? "yes" : "NO");

  Serial.printf("[MEM] after camera  heap=%luK\n", (unsigned long)(ESP.getFreeHeap() / 1024));

  g_sdOK = sdMount();
  if (!g_sdOK) Serial.println("[SD]  NOT AVAILABLE — photos fall back to PSRAM");
  Serial.printf("[MEM] after SD      heap=%luK\n", (unsigned long)(ESP.getFreeHeap() / 1024));
  g_pending = queueCount();
  Serial.printf("[SD]  next photo #%lu, %lu queued for sending\n",
                (unsigned long)g_nextNum, (unsigned long)g_pending);

  // After SD init: the driver leaves a pull-up on DAT3/GPIO13 that we replace.
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  WiFi.persistent(false);
  WiFi.setAutoReconnect(true);
  WiFi.mode(WIFI_AP_STA);
  // Must come AFTER mode() or it never reaches the DHCP client. Worth having:
  // many routers then resolve http://kewlcam/ on their own, which works on
  // Android where .local does not.
  WiFi.setHostname("kewlcam");
  WiFi.setSleep(false);                 // modem sleep costs 100+ ms per packet
  WiFi.onEvent(onWiFiEvent);
  apStart();
  for (int i = 0; i < 3; i++) {
    if (g_ssid[i][0]) {
      wifiMulti.addAP(g_ssid[i], g_pass[i]);
      Serial.printf("[STA] slot %d: \"%s\"\n", i + 1, g_ssid[i]);
    }
  }
  // Full TX power. Trimming it saved a little current but cost link margin,
  // which is the difference between joining the house network and falling
  // back to the AP.
  WiFi.setTxPower(WIFI_POWER_19_5dBm);

  // NOTE: mDNS is (re)started by netTask once the STA actually has an IP —
  // registering it here, before there is an address, is why kewlcam.local
  // resolved on the AP but not on the house network.

  server.on("/",            handleRoot);
  server.on("/config.json", handleConfig);
  server.on("/photo",       handlePhoto);
  server.on("/file",        handleFile);
  server.on("/list",        handleList);
  server.on("/status",      handleStatus);
  server.on("/queue",       handleQueueAdd);
  server.on("/sent",        handleSent);
  server.on("/retry",       handleRetry);
  server.on("/settings",    handleSettings);
  server.on("/scan",        handleScan);
  server.on("/wifi", HTTP_GET,  handleWifiGet);
  server.on("/wifi", HTTP_POST, handleWifiSet);
  server.on("/reboot",      handleReboot);
  server.on("/update", HTTP_POST, handleUpdateDone, handleUpdateUpload);
  server.onNotFound([]() {
    Serial.printf("[Web] 404 %s from %s\n", server.uri().c_str(),
                  server.client().remoteIP().toString().c_str());
    server.send(404, "text/plain", "Not found");
  });
  server.begin();
  Serial.printf("[Web] begin: listening=%s\n", server.listening() ? "YES" : "NO");
  Serial.printf("[MEM] after AP+web  heap=%luK\n", (unsigned long)(ESP.getFreeHeap() / 1024));

  // camTask on core 1 at high priority: nothing the web server or the uploader
  // is doing can delay the shutter.
  xTaskCreatePinnedToCore(camTaskFn, "cam", 8192, nullptr, 5, &g_camTask, 1);
  // Roomy: the mbedtls handshake alone wants several KB on top of the
  // multipart and command buffers.
  xTaskCreatePinnedToCore(netTaskFn, "net", 14336, nullptr, 2, &g_netTask, 0);

  s_btnArmed = true;
  restoreButtonPin();
  Serial.printf("[BTN] GPIO %d -> GND, interrupt armed\n", BUTTON_PIN);

#if ESP_ARDUINO_VERSION_MAJOR >= 3
  esp_task_wdt_config_t wcfg = { .timeout_ms = WDT_SECONDS * 1000, .idle_core_mask = 0, .trigger_panic = true };
  esp_task_wdt_reconfigure(&wcfg);
#else
  esp_task_wdt_init(WDT_SECONDS, true);
#endif
  esp_task_wdt_add(nullptr);

  ledSet(false);
  blink(3);
  g_lastActivity = millis();
  Serial.println("===== ready =====\n");
}

/*═══════════════════════════════════════════════════════════════════════╗
║  13. Loop — web server, LED, supervision                               ║
╚═══════════════════════════════════════════════════════════════════════*/

void loop() {
  esp_task_wdt_reset();

  if (g_rebindServer) {
    g_rebindServer = false;
    server.close();
    server.begin();
    if (!server.listening()) {          // begin() cannot report this itself
      Serial.println("[Web] rebind FAILED — retrying once");
      delay(200);
      server.close();
      server.begin();
    }
    Serial.printf("[Web] rebind: listening=%s  heap=%luK\n",
                  server.listening() ? "YES" : "NO",
                  (unsigned long)(ESP.getFreeHeap() / 1024));
  }

  server.handleClient();

  // Non-blocking blink playback.
  if (g_blinks > 0 && millis() - g_ledAt > 110) {
    g_ledAt = millis();
    ledSet(!g_ledOn);
    if (!g_ledOn) g_blinks--;
  } else if (g_blinks == 0 && g_ledOn && !g_busyCapture) {
    ledSet(false);
  }

  // Debounced settings persistence — a slider drag is one NVS write, not fifty.
  if (g_cfgDirtyAt && millis() - g_cfgDirtyAt > 2500) {
    g_cfgDirtyAt = 0;
    prefsSaveCam();
  }

  // Heartbeat: the one line that shows whether the link, the heap or the queue
  // is the thing going wrong. Send me 2 minutes of these if it is still slow.
  static uint32_t lastBeat = 0;
  if (millis() - lastBeat > 30000) {
    lastBeat = millis();
    Serial.printf("[HB]  %lus  wifi=%s rssi=%d drops=%lu  ap=%d  pend=%lu sent=%lu shot=%lu  heap=%luK\n",
                  (unsigned long)(millis() / 1000),
                  WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString().c_str() : "DOWN",
                  WiFi.status() == WL_CONNECTED ? WiFi.RSSI() : 0,
                  (unsigned long)g_wifiDrops, g_apOn ? 1 : 0,
                  (unsigned long)g_pending, (unsigned long)g_sentTotal,
                  (unsigned long)g_shotTotal,
                  (unsigned long)(ESP.getFreeHeap() / 1024));
  }

  static uint32_t lastCheck = 0;
  if (millis() - lastCheck > 10000) {
    lastCheck = millis();
    g_pending = queueCount();

    // Camera wedged (bad power, sensor lockup) → rebuild it in place.
    if (g_camFails >= 5) {
      Serial.println("[CAM] repeated failures — reinitialising");
      if (xSemaphoreTake(g_camMux, pdMS_TO_TICKS(3000))) {
        esp_camera_deinit();
        delay(200);
        g_camOK = initCamera();
        xSemaphoreGive(g_camMux);
      }
      g_camFails = g_camOK ? 0 : 99;
      if (!g_camOK) { Serial.println("[CAM] unrecoverable — rebooting"); delay(200); ESP.restart(); }
    }

    // Card pulled or died → keep retrying the mount in the background.
    if (!g_sdOK) {
      g_sdOK = sdMount();
      if (g_sdOK) { g_pending = queueCount(); Serial.println("[SD]  back online"); }
    }

    if (ESP.getFreeHeap() < 20000) {
      Serial.println("[SYS] heap exhausted — rebooting");
      delay(200);
      ESP.restart();
    }

#if AUTO_REBOOT_HOURS
    bool idle = !g_pending && !g_busyCapture &&
                (millis() - g_lastActivity > 300000UL) &&
                WiFi.softAPgetStationNum() == 0;
    if (idle && millis() > (uint32_t)AUTO_REBOOT_HOURS * 3600000UL) {
      Serial.println("[SYS] scheduled idle reboot");
      delay(200);
      ESP.restart();
    }
#endif
  }

  delay(1);   // yields to the idle task; the button path does not go through here
}
