static bool webSelfTest(char* detail, size_t n);
static int  scanForBest(int* bestRssi, char* bestSsid, size_t n);

// Telegram chat ids exceed 32 bits, so this must not be a long.
static int64_t jsonNum(const String& s, const char* key) {
  int i = s.indexOf(key);
  if (i < 0) return INT64_MIN;
  i += strlen(key);
  while (i < (int)s.length() && s[i] == ' ') i++;
  return strtoll(s.c_str() + i, nullptr, 10);
}
// Finds `key` only after `scope` appears, so "id" inside "chat" is not
// confused with the "id" inside "from". Tolerates spacing and key order.
static int64_t jsonNumIn(const String& s, const char* scope, const char* key) {
  int i = (scope && *scope) ? s.indexOf(scope) : 0;
  if (i < 0) return INT64_MIN;
  int j = s.indexOf(key, i);
  if (j < 0) return INT64_MIN;
  j += strlen(key);
  while (j < (int)s.length() && (s[j] == ' ' || s[j] == ':')) j++;
  if (j >= (int)s.length()) return INT64_MIN;
  return strtoll(s.c_str() + j, nullptr, 10);
}
// `key` is the bare quoted name, e.g. "\"text\"" — the separator and any
// spacing around it are skipped here rather than baked into the search.
static String jsonStr(const String& s, const char* key) {
  int i = s.indexOf(key);
  if (i < 0) return String();
  i += strlen(key);
  while (i < (int)s.length() && (s[i] == ' ' || s[i] == ':')) i++;
  if (i >= (int)s.length() || s[i] != '"') return String();
  i++;
  String out;
  bool esc = false;
  for (; i < (int)s.length() && out.length() < 120; i++) {
    char c = s[i];
    if (esc) { out += (c == 'n' ? '\n' : c); esc = false; continue; }
    if (c == '\\') { esc = true; continue; }
    if (c == '"') break;
    out += c;
  }
  return out;
}

static void tgSaveOffset() {
  if (!xSemaphoreTake(g_nvsMux, pdMS_TO_TICKS(2000))) return;
  prefs.putLong64("tgoff", g_tgOffset);
  xSemaphoreGive(g_nvsMux);
}

