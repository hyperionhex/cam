// one is at least ROAM_MARGIN_DBM stronger, so it cannot flap between two.
#define ROAM_TRIGGER_DBM (-73)
#define ROAM_MARGIN_DBM    8

#define BOT_COMMANDS      1          // 1 = listen for /photo etc. from Telegram
#define BOT_POLL_SECONDS 20          // long-poll window; commands land instantly

