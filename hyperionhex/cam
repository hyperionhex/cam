║  9. Telegram — streamed from the card, never buffered whole in RAM     ║
╚═══════════════════════════════════════════════════════════════════════*/

static void captionFor(char* out, size_t n, uint32_t num) {
  if (g_timeOK) {
    time_t t = time(nullptr);
    struct tm tm; localtime_r(&t, &tm);
    char ts[32];
    strftime(ts, sizeof ts, "%Y-%m-%d %H:%M", &tm);
    snprintf(out, n, "KewlCam #%lu  %s", (unsigned long)num, ts);
  } else {
    snprintf(out, n, "KewlCam #%lu", (unsigned long)num);
  }
}

/*
  One TLS session, reused across a whole drain burst. The handshake to
  api.telegram.org costs 1-2 s on this chip; paying it per photo was most of
  what made the queue feel slow. Only netTask ever touches g_tg, so no mutex.
*/
static WiFiClientSecure g_tg;
static uint32_t g_tgIdleSince = 0;

static bool tgConnect() {
  if (g_tg.connected()) return true;
  g_tg.stop();
  g_tg.setInsecure();
  g_tg.setTimeout(12);
  uint32_t t0 = millis();
  bool ok = g_tg.connect("api.telegram.org", 443, 12000);
  Serial.printf("[TG]  handshake %s (%lu ms)\n",
                ok ? "ok" : "FAILED", (unsigned long)(millis() - t0));
  return ok;
}
static void tgClose() { g_tg.stop(); }

/*
  Reads the status line, the headers, then exactly Content-Length body bytes,
  so the socket is left positioned at the next response and can be reused.
  Anything we cannot account for exactly → *reusable = false and the caller
  drops the connection rather than risk desyncing the next request.
*/
static bool tgReadReply(bool* reusable, String* bodyOut = nullptr,
                        bool abortOnQueue = false) {
  *reusable = false;
  const size_t cap = bodyOut ? 1600 : 240;
  uint32_t t0 = millis();
  uint32_t limit = abortOnQueue ? (BOT_POLL_SECONDS + 12) * 1000UL : 20000UL;
  String line; line.reserve(96);
  long clen = -1;
  bool chunked = false, headersDone = false;

  while (millis() - t0 < limit) {
    if (!g_tg.available()) {
      if (!g_tg.connected()) return false;
      // A photo just landed in the queue — stop waiting on a long poll and go
      // deliver it. The socket is mid-response, so it cannot be reused.
      if (abortOnQueue && g_pending) { g_tg.stop(); return false; }
      vTaskDelay(pdMS_TO_TICKS(5));
      continue;
    }
    char ch = (char)g_tg.read();
    if (ch == '\r') continue;
    if (ch != '\n') { if (line.length() < 90) line += ch; continue; }
    if (line.length() == 0) { headersDone = true; break; }
    String lc = line; lc.toLowerCase();
    if (lc.startsWith("content-length:")) clen = lc.substring(15).toInt();
    else if (lc.startsWith("transfer-encoding:") && lc.indexOf("chunked") >= 0) chunked = true;
    line = "";
  }
  if (!headersDone) return false;

  String body; body.reserve(cap > 512 ? 512 : cap);
  if (clen >= 0 && !chunked) {
    long left = clen;
    while (left > 0 && millis() - t0 < limit) {
      if (!g_tg.available()) {
        if (!g_tg.connected()) break;
        vTaskDelay(pdMS_TO_TICKS(5));
        continue;
      }
      // Every byte is consumed to keep the socket in sync; only the first
      // `cap` are kept.
      if (body.length() < cap) body += (char)g_tg.read(); else g_tg.read();
      left--;
    }
    *reusable = (left == 0) && g_tg.connected();
  } else {
    while ((g_tg.connected() || g_tg.available()) && millis() - t0 < limit) {
      while (g_tg.available()) {
        char ch = (char)g_tg.read();
        if (body.length() < cap) body += ch;
      }
      if (body.indexOf("\"ok\":") >= 0) break;
      vTaskDelay(pdMS_TO_TICKS(5));
    }
  }
  if (bodyOut) *bodyOut = body;
  if (body.indexOf("\"ok\":true") >= 0) return true;
  if (body.length()) Serial.printf("[TG]  reply: %s\n", body.c_str());
  return false;
}

static bool tgSend(uint32_t num, File* src, const uint8_t* mem, size_t memLen) {
  if (WiFi.status() != WL_CONNECTED) return false;
  size_t bodyLen = src ? src->size() : memLen;
  if (!bodyLen || bodyLen > 9UL * 1024 * 1024) return false;

  const char* bnd = "KCamBnd7f3a";
  char cap[64]; captionFor(cap, sizeof cap, num);
  char head[512];
  int hl = snprintf(head, sizeof head,
    "--%s\r\nContent-Disposition: form-data; name=\"chat_id\"\r\n\r\n%s\r\n"
    "--%s\r\nContent-Disposition: form-data; name=\"caption\"\r\n\r\n%s\r\n"
    "--%s\r\nContent-Disposition: form-data; name=\"photo\"; "
    "filename=\"kewlcam_%05lu.jpg\"\r\nContent-Type: image/jpeg\r\n\r\n",
    bnd, CHAT_ID, bnd, cap, bnd, (unsigned long)num);
  char tail[32];
  int tl = snprintf(tail, sizeof tail, "\r\n--%s--\r\n", bnd);

  // Two attempts: a reused socket the far end quietly dropped looks exactly
  // like a failure, and costs one retry on a fresh one to tell apart.
  for (int attempt = 0; attempt < 2; attempt++) {
    if (!tgConnect()) return false;
    if (src && !src->seek(0)) { tgClose(); return false; }
    uint32_t t0 = millis();

    bool wrote = true;
    g_tg.printf("POST /bot%s/sendPhoto HTTP/1.1\r\n", BOT_TOKEN);
    g_tg.print(F("Host: api.telegram.org\r\nConnection: keep-alive\r\n"));
    g_tg.printf("Content-Type: multipart/form-data; boundary=%s\r\n", bnd);
    g_tg.printf("Content-Length: %lu\r\n\r\n", (unsigned long)(hl + bodyLen + tl));
    if (g_tg.write((const uint8_t*)head, hl) != (size_t)hl) wrote = false;

    if (wrote && src) {
      // From PSRAM, not DRAM and not the stack: internal memory is the scarce
      // resource here and mbedtls needs every KB of it.
      static uint8_t* buf = nullptr;
      if (!buf) {
        buf = (uint8_t*)ps_malloc(4096);
        if (!buf) buf = (uint8_t*)malloc(4096);
      }
      if (!buf) { tgClose(); return false; }
      const size_t bufSz = 4096;
      size_t left = bodyLen;
      while (left && wrote) {
        // Released between chunks so a button press can still write to the
        // card in the middle of a slow upload.
        if (!SD_LOCK(4000)) { wrote = false; break; }
        int r = src->read(buf, left < bufSz ? left : bufSz);
        SD_UNLOCK();
        if (r <= 0) { wrote = false; break; }
        if (g_tg.write(buf, r) != (size_t)r) { wrote = false; break; }
        left -= r;
      }
    } else if (wrote) {
      size_t left = memLen, off = 0;
      while (left) {
        size_t chunk = left < 4096 ? left : 4096;
        if (g_tg.write(mem + off, chunk) != chunk) { wrote = false; break; }
        off += chunk; left -= chunk;
      }
    }
    if (wrote && g_tg.write((const uint8_t*)tail, tl) != (size_t)tl) wrote = false;

    bool reusable = false;
    bool ok = wrote && tgReadReply(&reusable);
    if (!reusable) tgClose();
    g_tgIdleSince = millis();

    if (ok) {
      Serial.printf("[TG]  #%lu sent, %lu B in %lu ms%s\n",
                    (unsigned long)num, (unsigned long)bodyLen,
                    (unsigned long)(millis() - t0), reusable ? " (socket kept)" : "");
      return true;
    }
    if (attempt == 0 && !reusable) continue;   // stale socket → one clean retry
    Serial.printf("[TG]  #%lu FAILED\n", (unsigned long)num);
    return false;
  }
  return false;
}

static void urlEncode(const char* in, char* out, size_t n) {
  static const char* hex = "0123456789ABCDEF";
  size_t o = 0;
  for (const char* p = in; *p && o + 4 < n; p++) {
    unsigned char c = (unsigned char)*p;
    if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') out[o++] = c;
    else { out[o++] = '%'; out[o++] = hex[c >> 4]; out[o++] = hex[c & 15]; }
  }
  out[o] = 0;
}

// Used to announce the camera's IP on boot, so finding the web UI never
// depends on .local resolving.
static bool tgSendText(const char* msg) {
  if (WiFi.status() != WL_CONNECTED) return false;
  if (!tgConnect()) return false;
  // Percent-encoding can triple the length (every space and newline becomes
  // three bytes), so size for the worst case — the previous 320 was quietly
  // cutting /status and the boot announcement short. Static because netTask
  // is the only caller and the handshake wants the stack.
  static char* enc = nullptr;
  static char* body = nullptr;
  if (!enc)  { enc  = (char*)ps_malloc(1700); if (!enc)  enc  = (char*)malloc(1700); }
  if (!body) { body = (char*)ps_malloc(1800); if (!body) body = (char*)malloc(1800); }
  if (!enc || !body) return false;
  urlEncode(msg, enc, 1700);
  int bl = snprintf(body, 1800, "chat_id=%s&text=%s", CHAT_ID, enc);
  g_tg.printf("POST /bot%s/sendMessage HTTP/1.1\r\n", BOT_TOKEN);
  g_tg.print(F("Host: api.telegram.org\r\nConnection: keep-alive\r\n"
               "Content-Type: application/x-www-form-urlencoded\r\n"));
  g_tg.printf("Content-Length: %d\r\n\r\n", bl);
  g_tg.write((const uint8_t*)body, bl);
  bool reusable = false;
  bool ok = tgReadReply(&reusable);
  if (!reusable) tgClose();
  g_tgIdleSince = millis();
  return ok;
}

