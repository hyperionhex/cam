#define CPU_MHZ     240              // 240 fastest · 160 balanced · 80 coolest
// ON by default now. With one radio, AP+STA time-slices the air, which on a
// weak uplink is the difference between a page loading and timing out; it can
// also send replies for inbound STA connections out of the AP interface.
// softAPdisconnect() does recreate the netifs and drop the listening socket,
// so every AP transition triggers a rebind that is then VERIFIED via
// server.listening() — the failure that used to be silent now cannot be.
// The AP returns automatically whenever the STA link drops.
#define AP_AUTO_OFF 1
#define AP_GRACE_MS 60000UL          // keep the AP this long after boot anyway
#define AUTO_REBOOT_HOURS 24         // 0 = never. Only reboots when fully idle.

